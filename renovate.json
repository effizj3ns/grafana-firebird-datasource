{
  "version": 2,
  "updates": [
    {
      "package-ecosystem": "gomod",
      "directory": "/",
      "schedule": { "interval": "weekly" },
      "open-pull-requests-limit": 5
    },
    {
      "package-ecosystem": "npm",
      "directory": "/",
      "schedule": { "interval": "weekly" },
      "open-pull-requests-limit": 10,
      "groups": {
        "grafana-packages": { "patterns": ["@grafana/*"] },
        "dev-deps": { "dependency-type": "development" }
      }
    }
  ]
}
